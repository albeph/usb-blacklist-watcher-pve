#!/bin/bash
# postinst — executed by dpkg after package installation/upgrade
set -euo pipefail

BLACKLIST_DIR="/etc/usb-blacklist-watcher-pve"
BLACKLIST_FILE="${BLACKLIST_DIR}/blacklist.conf"
SERVICE_NAME="usb-blacklist-watcher-pve.service"
OLD_BLACKLIST_DIR="/etc/usb-blacklist-watcher"
OLD_BLACKLIST_FILE="${OLD_BLACKLIST_DIR}/blacklist.conf"

# ─────────────────────────────────────────────────────────────────────────────
# UTILITIES
# ─────────────────────────────────────────────────────────────────────────────

info() { echo "  [usb-blacklist-watcher-pve] $*"; }
warn() { echo "  [usb-blacklist-watcher-pve] WARNING: $*" >&2; }

# ─────────────────────────────────────────────────────────────────────────────
# DIRECTORY AND STATE FILE CREATION
# ─────────────────────────────────────────────────────────────────────────────

setup_config_dir() {
    if [ ! -d "${BLACKLIST_DIR}" ]; then
        info "Creating configuration directory: ${BLACKLIST_DIR}"
        mkdir -p "${BLACKLIST_DIR}"
    fi

    # If the old blacklist exists (/etc/usb-blacklist-watcher/blacklist.conf)
    # and the new one is not yet present, migrate user configuration.
    if [ ! -f "${BLACKLIST_FILE}" ] && [ -f "${OLD_BLACKLIST_FILE}" ]; then
        info "Migrating existing configuration from ${OLD_BLACKLIST_FILE} to ${BLACKLIST_FILE}..."
        cp -a "${OLD_BLACKLIST_FILE}" "${BLACKLIST_FILE}"
    fi

    # Create blacklist file ONLY if it does not already exist (preserve user
    # configuration across upgrades or reinstallations).
    if [ ! -f "${BLACKLIST_FILE}" ]; then
        info "Creating default blacklist file: ${BLACKLIST_FILE}"
        cat > "${BLACKLIST_FILE}" <<'EOF'
# usb-blacklist-watcher-pve — USB Device Blacklist
#
# This file defines USB devices that must NEVER be passed through
# to any Proxmox VE virtual machine.
#
# Format: one entry per line — VENDOR:PRODUCT  # optional comment
#   Example:  2e8a:0005  # MicroPython Board in FS mode
#   Example:  0bda:8156  # Realtek USB 10/100/1G/2.5G LAN
#
# - Blank lines and lines starting with '#' are ignored.
# - IDs are 4-digit hexadecimal format, as shown by `lsusb`.
# - To add/remove devices interactively, use:
#     usb-blacklist-select
#
EOF
    else
        info "Blacklist file preserved: ${BLACKLIST_FILE}"
    fi

    # Restrictive permissions: this file guides a security mechanism.
    chmod 700 "${BLACKLIST_DIR}"
    chmod 600 "${BLACKLIST_FILE}"
    chown root:root "${BLACKLIST_DIR}" "${BLACKLIST_FILE}"
}

# ─────────────────────────────────────────────────────────────────────────────
# ENABLE AND START SYSTEMD SERVICE
# ─────────────────────────────────────────────────────────────────────────────

setup_service() {
    if ! command -v systemctl &>/dev/null; then
        warn "systemctl not found — skipping service enablement."
        warn "Enable manually with: systemctl enable --now ${SERVICE_NAME}"
        return 0
    fi

    # If the old usb-blacklist-watcher service was active, stop it
    if systemctl is-active --quiet "usb-blacklist-watcher.service" 2>/dev/null; then
        info "Stopping previous service usb-blacklist-watcher.service..."
        systemctl stop "usb-blacklist-watcher.service" || true
        systemctl disable "usb-blacklist-watcher.service" || true
    fi

    info "Reloading systemd unit files..."
    systemctl daemon-reload

    info "Enabling and starting service ${SERVICE_NAME}..."
    systemctl enable --now "${SERVICE_NAME}" || {
        warn "Unable to start ${SERVICE_NAME} now."
        warn "pve-cluster might need to be mounted first."
        warn "Start manually with: systemctl start ${SERVICE_NAME}"
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# FINAL MESSAGE
# ─────────────────────────────────────────────────────────────────────────────

print_welcome() {
    echo ""
    echo "┌─────────────────────────────────────────────────────────────┐"
    echo "│       usb-blacklist-watcher-pve installed successfully      │"
    echo "├─────────────────────────────────────────────────────────────┤"
    echo "│                                                               │"
    echo "│  To choose which USB devices to protect, run:                │"
    echo "│                                                               │"
    echo "│      usb-blacklist-select                                     │"
    echo "│                                                               │"
    echo "│  To check watcher status:                                     │"
    echo "│      systemctl status usb-blacklist-watcher-pve               │"
    echo "│                                                               │"
    echo "│  Blacklist:  /etc/usb-blacklist-watcher-pve/blacklist.conf    │"
    echo "│  Logs:       journalctl -u usb-blacklist-watcher-pve -f       │"
    echo "│                                                               │"
    echo "└─────────────────────────────────────────────────────────────┘"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# MAIN — handle standard dpkg actions
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    configure)
        setup_config_dir
        setup_service
        print_welcome
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        # Nothing to do on rollback
        ;;
    *)
        warn "postinst called with unexpected action: '${1:-}'"
        exit 1
        ;;
esac

exit 0
