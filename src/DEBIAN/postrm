#!/bin/bash
# postrm — executed by dpkg AFTER package removal
set -euo pipefail

BLACKLIST_DIR="/etc/usb-blacklist-watcher-pve"
OLD_BLACKLIST_DIR="/etc/usb-blacklist-watcher"
UDEV_RULES_FILE="/etc/udev/rules.d/99-usb-blacklist-watcher-pve.rules"

# ─────────────────────────────────────────────────────────────────────────────
# UTILITIES
# ─────────────────────────────────────────────────────────────────────────────

info() { echo "  [usb-blacklist-watcher-pve] $*"; }
warn() { echo "  [usb-blacklist-watcher-pve] WARNING: $*" >&2; }

# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    purge)
        # Only on complete purge: remove configuration directory, blacklist, and advanced protection.
        # On simple "remove", the configuration is preserved for future reinstallation.
        if [ -f "${UDEV_RULES_FILE}" ]; then
            info "Purge: removing Udev rules ${UDEV_RULES_FILE}..."
            rm -f "${UDEV_RULES_FILE}"
            if command -v udevadm &>/dev/null; then
                udevadm control --reload-rules && udevadm trigger --subsystem-match=usb || true
            fi
        fi
        if [ -d "${BLACKLIST_DIR}" ]; then
            info "Purge: removing configuration directory ${BLACKLIST_DIR}..."
            rm -rf "${BLACKLIST_DIR}"
            info "Configuration removed."
        fi
        if [ -d "${OLD_BLACKLIST_DIR}" ]; then
            info "Purge: removing previous configuration directory ${OLD_BLACKLIST_DIR}..."
            rm -rf "${OLD_BLACKLIST_DIR}"
        fi
        # Reload daemon units after removing .service file
        if command -v systemctl &>/dev/null; then
            systemctl daemon-reload || true
        fi
        ;;
    remove)
        # Simple remove: configuration is preserved in ${BLACKLIST_DIR}.
        # Reload daemon units after removing .service file.
        if command -v systemctl &>/dev/null; then
            systemctl daemon-reload || true
        fi
        info "Configuration preserved in ${BLACKLIST_DIR} (use 'apt purge' to remove it)."
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Nothing to do
        ;;
    *)
        warn "postrm called with unexpected action: '${1:-}'"
        exit 1
        ;;
esac

exit 0
