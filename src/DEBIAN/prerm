#!/bin/bash
# prerm — executed by dpkg BEFORE package removal
set -euo pipefail

SERVICE_NAME="usb-blacklist-watcher-pve.service"
OLD_SERVICE_NAME="usb-blacklist-watcher.service"
UDEV_RULES_FILE="/etc/udev/rules.d/99-usb-blacklist-watcher-pve.rules"

# ─────────────────────────────────────────────────────────────────────────────
# UTILITIES
# ─────────────────────────────────────────────────────────────────────────────

info() { echo "  [usb-blacklist-watcher-pve] $*"; }
warn() { echo "  [usb-blacklist-watcher-pve] WARNING: $*" >&2; }

# ─────────────────────────────────────────────────────────────────────────────
# STOP AND DISABLE SERVICE
# ─────────────────────────────────────────────────────────────────────────────

stop_service() {
    if ! command -v systemctl &>/dev/null; then
        warn "systemctl not found — skipping service stop."
        return 0
    fi

    if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
        info "Stopping service ${SERVICE_NAME}..."
        systemctl stop "${SERVICE_NAME}" || warn "Unable to stop service."
    fi

    if systemctl is-enabled --quiet "${SERVICE_NAME}" 2>/dev/null; then
        info "Disabling service ${SERVICE_NAME}..."
        systemctl disable "${SERVICE_NAME}" || warn "Unable to disable service."
    fi

    if systemctl is-active --quiet "${OLD_SERVICE_NAME}" 2>/dev/null; then
        info "Stopping legacy service ${OLD_SERVICE_NAME}..."
        systemctl stop "${OLD_SERVICE_NAME}" || true
        systemctl disable "${OLD_SERVICE_NAME}" || true
    fi
}

cleanup_udev_rules() {
    if [ -f "${UDEV_RULES_FILE}" ]; then
        info "Removing Udev Advanced Protection rules: ${UDEV_RULES_FILE}..."
        rm -f "${UDEV_RULES_FILE}"
        if command -v udevadm &>/dev/null; then
            udevadm control --reload-rules && udevadm trigger --subsystem-match=usb || true
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    remove|deconfigure)
        stop_service
        cleanup_udev_rules
        ;;
    upgrade|failed-upgrade)
        stop_service
        ;;
    *)
        warn "prerm called with unexpected action: '${1:-}'"
        exit 1
        ;;
esac

exit 0
