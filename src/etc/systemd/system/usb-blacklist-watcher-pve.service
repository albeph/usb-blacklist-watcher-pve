[Unit]
Description=USB Blacklist Watcher for Proxmox VE (usb-blacklist-watcher-pve)
Documentation=man:usb-blacklist-watcher-pve(8)
After=network.target pve-cluster.service
Wants=pve-cluster.service

[Service]
Type=simple
ExecStart=/usr/local/bin/usb-blacklist-watcher-pve
Restart=always
RestartSec=5
# Logging via journald (stdout/stderr captured automatically)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usb-blacklist-watcher-pve
# Minimal security: service runs as root (required by qm and to
# read VM configs in pmxcfs) but filesystem access is limited.
# ProtectSystem and similar are omitted to prevent blocking access to /etc/pve.

[Install]
WantedBy=multi-user.target
Alias=usb-blacklist-watcher.service
