#!/bin/bash
# usb-blacklist-select — Tool interattivo per gestire la blacklist USB
#
# Uso interattivo:
#   usb-blacklist-select
#
# Uso non-interattivo (scripting):
#   usb-blacklist-select --list
#   usb-blacklist-select --add VENDOR:PRODUCT
#   usb-blacklist-select --remove VENDOR:PRODUCT
#
# Il tool salva la blacklist in /etc/usb-blacklist-watcher-pve/blacklist.conf
# e applica immediatamente l'enforcement su tutte le VM configurate.

set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURAZIONE
# ─────────────────────────────────────────────────────────────────────────────

readonly BLACKLIST_FILE="/etc/usb-blacklist-watcher-pve/blacklist.conf"
readonly BLACKLIST_DIR="/etc/usb-blacklist-watcher-pve"
readonly QEMU_DIR="/etc/pve/qemu-server"

# ID dei root hub e hub generici Linux Foundation da filtrare (opzionale)
readonly FILTER_IDS=("1d6b:0001" "1d6b:0002" "1d6b:0003")

# ─────────────────────────────────────────────────────────────────────────────
# UTILITY
# ─────────────────────────────────────────────────────────────────────────────

info()    { echo "  ✓ $*"; }
warn()    { echo "  ⚠ $*" >&2; }
error()   { echo "  ✗ $*" >&2; }
section() { echo ""; echo "── $* ─────────────────────────────────────────────"; }

# Verifica che l'utente sia root
check_root() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        error "Questo tool deve essere eseguito come root."
        echo "    Riprova con: sudo usb-blacklist-select $*"
        exit 1
    fi
}

# Valida il formato VENDOR:PRODUCT (4 cifre hex : 4 cifre hex)
validate_usb_id() {
    local id="${1}"
    if [[ ! "${id}" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]]; then
        error "Formato ID USB non valido: '${id}'"
        error "Formato atteso: VENDOR:PRODUCT in esadecimale (es. 2e8a:0005)"
        return 1
    fi
    # Normalizza in minuscolo
    echo "${id,,}"
}

# ─────────────────────────────────────────────────────────────────────────────
# GESTIONE FILE DI BLACKLIST
# ─────────────────────────────────────────────────────────────────────────────

# Assicura che la directory e il file di blacklist esistano.
ensure_blacklist_file() {
    if [ ! -d "${BLACKLIST_DIR}" ]; then
        mkdir -p "${BLACKLIST_DIR}"
        chmod 700 "${BLACKLIST_DIR}"
        chown root:root "${BLACKLIST_DIR}"
    fi

    if [ ! -f "${BLACKLIST_FILE}" ]; then
        cat > "${BLACKLIST_FILE}" <<'EOF'
# usb-blacklist-watcher-pve — Blacklist dispositivi USB
#
# Formato: VENDOR:PRODUCT  # commento opzionale
# Righe vuote e righe che iniziano con '#' vengono ignorate.
#
EOF
        chmod 600 "${BLACKLIST_FILE}"
        chown root:root "${BLACKLIST_FILE}"
    fi
}

# Legge la blacklist e restituisce gli ID (VENDOR:PRODUCT) uno per riga,
# normalizzati in minuscolo.
read_blacklist() {
    if [ ! -f "${BLACKLIST_FILE}" ]; then
        return 0
    fi
    grep -v '^\s*#' "${BLACKLIST_FILE}" \
        | grep -v '^\s*$' \
        | awk '{print tolower($1)}' \
        | grep -E '^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$' \
        || true
}

# Controlla se un ID è già in blacklist. Ritorna 0 se sì, 1 se no.
# FIX 4: accetta la blacklist pre-letta come secondo argomento opzionale,
# evitando una lettura del file per ogni device mostrato nella UI.
is_in_blacklist() {
    local id="${1,,}"
    local cached_blacklist="${2:-$(read_blacklist)}"
    echo "${cached_blacklist}" | grep -qi "^${id}$"
}

# Aggiunge un ID alla blacklist (se non già presente).
# Argomenti: id [descrizione opzionale]
blacklist_add() {
    local id="${1,,}"
    local desc="${2:-}"

    ensure_blacklist_file

    if is_in_blacklist "${id}"; then
        warn "${id} è già in blacklist — nessuna modifica."
        return 0
    fi

    local comment=""
    [ -n "${desc}" ] && comment=" # ${desc}"

    echo "${id}${comment}" >> "${BLACKLIST_FILE}"
    chmod 600 "${BLACKLIST_FILE}"
    info "Aggiunto alla blacklist: ${id}${comment}"
}

# Rimuove un ID dalla blacklist.
blacklist_remove() {
    local id="${1,,}"

    ensure_blacklist_file

    if ! is_in_blacklist "${id}"; then
        warn "${id} non è in blacklist — nessuna modifica."
        return 0
    fi

    # Rimuove la riga che inizia con l'ID (case-insensitive), preservando commenti
    # globali e altre entry.
    local tmp_file
    tmp_file=$(mktemp)
    grep -iv "^${id}\b" "${BLACKLIST_FILE}" > "${tmp_file}" || true
    mv "${tmp_file}" "${BLACKLIST_FILE}"
    chmod 600 "${BLACKLIST_FILE}"
    chown root:root "${BLACKLIST_FILE}"
    info "Rimosso dalla blacklist: ${id}"
}

# ─────────────────────────────────────────────────────────────────────────────
# SCOPERTA DEVICE USB
# ─────────────────────────────────────────────────────────────────────────────

# Esegue lsusb e raccoglie i device in un array associativo.
# Popola le variabili globali:
#   USB_IDS[]        — array di VENDOR:PRODUCT
#   USB_DESCS[]      — array di descrizioni
#   USB_COUNT        — numero totale di device
discover_usb_devices() {
    if ! command -v lsusb &>/dev/null; then
        error "Comando 'lsusb' non trovato. Installare usbutils."
        exit 1
    fi

    USB_IDS=()
    USB_DESCS=()
    USB_COUNT=0

    # Formato lsusb: "Bus 001 Device 002: ID 2e8a:0005 MicroPython Board in FS mode"
    while IFS= read -r line; do
        # Estrae vendor:product e descrizione
        local id desc
        id=$(echo "${line}" | grep -oP 'ID \K[0-9a-fA-F]{4}:[0-9a-fA-F]{4}' | tr '[:upper:]' '[:lower:]' || true)
        desc=$(echo "${line}" | sed -E 's/.*ID [0-9a-fA-F]{4}:[0-9a-fA-F]{4}\s*//' | xargs || true)

        [ -z "${id}" ] && continue

        # Filtra hub Linux Foundation
        local skip=0
        local filter_id
        for filter_id in "${FILTER_IDS[@]}"; do
            if [ "${id}" = "${filter_id}" ]; then
                skip=1
                break
            fi
        done
        [ "${skip}" -eq 1 ] && continue

        USB_IDS+=("${id}")
        USB_DESCS+=("${desc}")
        (( USB_COUNT++ )) || true

    done < <(lsusb 2>/dev/null)
}

# ─────────────────────────────────────────────────────────────────────────────
# DISPLAY
# ─────────────────────────────────────────────────────────────────────────────

# Mostra l'elenco dei device USB con stato blacklist.
# FIX 4: accetta la blacklist pre-letta come argomento per evitare
# N letture del file (una per device) durante la visualizzazione.
show_usb_list() {
    local cached_blacklist="${1:-$(read_blacklist)}"
    section "Dispositivi USB collegati"

    if [ "${USB_COUNT}" -eq 0 ]; then
        warn "Nessun dispositivo USB trovato (hub e root hub esclusi)."
        return 0
    fi

    local i
    for (( i=0; i<USB_COUNT; i++ )); do
        local id="${USB_IDS[$i]}"
        local desc="${USB_DESCS[$i]}"
        local idx=$(( i + 1 ))
        local marker=""

        if is_in_blacklist "${id}" "${cached_blacklist}"; then
            marker=" \e[1;33m[GIÀ IN BLACKLIST]\e[0m"
        fi

        printf "  \e[1m%3d\e[0m)  \e[36m%-15s\e[0m  %s%b\n" \
            "${idx}" "${id}" "${desc}" "${marker}"
    done
}

# Mostra la blacklist corrente.
show_blacklist() {
    section "Blacklist corrente"
    local entries
    entries=$(read_blacklist)

    if [ -z "${entries}" ]; then
        echo "  (vuota)"
        return 0
    fi

    local id
    while IFS= read -r id; do
        # Cerca la descrizione tra i device USB rilevati
        local desc=""
        local j
        for (( j=0; j<USB_COUNT; j++ )); do
            if [ "${USB_IDS[$j]}" = "${id}" ]; then
                desc="${USB_DESCS[$j]}"
                break
            fi
        done
        printf "  \e[1;31m●\e[0m  \e[36m%-15s\e[0m  %s\n" "${id}" "${desc:-<device non collegato>}"
    done <<< "${entries}"
}

# ─────────────────────────────────────────────────────────────────────────────
# ENFORCEMENT IMMEDIATO
# ─────────────────────────────────────────────────────────────────────────────

# Applica l'enforcement su tutte le VM dopo una modifica alla blacklist.
# Questa funzione replica la logica del watcher per funzionare anche quando
# il servizio non è attivo (es. durante il setup iniziale).
trigger_enforcement() {
    section "Enforcement immediato"

    if ! command -v qm &>/dev/null; then
        warn "Comando 'qm' non trovato — skipping enforcement automatico."
        warn "Il watcher applicherà le modifiche al prossimo riavvio del servizio."
        return 0
    fi

    if [ ! -d "${QEMU_DIR}" ]; then
        warn "Directory ${QEMU_DIR} non trovata — pve-cluster montato?"
        return 0
    fi

    local current_blacklist
    current_blacklist=$(read_blacklist)

    if [ -z "${current_blacklist}" ]; then
        info "Blacklist vuota — nessun enforcement necessario."
        return 0
    fi

    local conf_file vmid found_action=0

    for conf_file in "${QEMU_DIR}"/*.conf; do
        [ -f "${conf_file}" ] || continue
        vmid=$(basename "${conf_file}" .conf)
        [[ "${vmid}" =~ ^[0-9]+$ ]] || continue

        # Per ogni device assegnato, verifica se è in blacklist
        local line
        while IFS= read -r line; do
            local key
            key=$(echo "${line}" | grep -oP "^usb\d+" || true)
            [ -z "${key}" ] && continue

            local host_val
            host_val=$(echo "${line}" | grep -oP "host=\K[^, ]+" || true)
            [ -z "${host_val}" ] && continue

            local actual_id=""
            if [[ "${host_val}" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]]; then
                actual_id="${host_val,,}"
            elif [[ "${host_val}" =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]]; then
                # Risoluzione bus-port tramite sysfs
                local sysfs_dir="/sys/bus/usb/devices/${host_val}"
                if [ -f "${sysfs_dir}/idVendor" ] && [ -f "${sysfs_dir}/idProduct" ]; then
                    local vendor product
                    vendor=$(cat "${sysfs_dir}/idVendor")
                    product=$(cat "${sysfs_dir}/idProduct")
                    actual_id="${vendor,,}:${product,,}"
                fi
            fi

            [ -z "${actual_id}" ] && continue

            # Se l'ID effettivo (vendor:product) è in blacklist, rimuoviamo
            if echo "${current_blacklist}" | grep -qi "^${actual_id}$"; then
                echo "  → VM ${vmid}: rimozione '${key}' (host=${host_val})..."
                qm set "${vmid}" --delete "${key}" 2>&1 | sed 's/^/    /' || \
                    warn "Errore rimuovendo '${key}' da VM ${vmid}"
                found_action=1
            fi
        done < <(grep -iP "^usb\d+:" "${conf_file}" || true)
    done

    if [ "${found_action}" -eq 0 ]; then
        info "Nessun device in blacklist trovato nelle configurazioni VM."
    else
        info "Enforcement completato."
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# MODALITÀ INTERATTIVA
# ─────────────────────────────────────────────────────────────────────────────

interactive_mode() {
    echo ""
    echo -e "\e[1;32m╔══════════════════════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;32m║        usb-blacklist-select — Gestione Blacklist USB     ║\e[0m"
    echo -e "\e[1;32m╚══════════════════════════════════════════════════════════╝\e[0m"

    discover_usb_devices

    # FIX 4: lettura unica della blacklist — passata a show_usb_list e show_blacklist
    # evita N+1 letture del file durante la visualizzazione iniziale
    local current_blacklist
    current_blacklist=$(read_blacklist)

    show_usb_list "${current_blacklist}"
    show_blacklist "${current_blacklist}"

    if [ "${USB_COUNT}" -eq 0 ]; then
        echo ""
        warn "Nessun device USB selezionabile trovato."
        exit 0
    fi

    section "Selezione"
    echo "  Inserisci i numeri dei device da aggiungere/rimuovere dalla blacklist."
    echo "  (Separati da spazio o virgola. Un device già in blacklist verrà rimosso.)"
    echo "  Premi INVIO senza input per annullare."
    echo ""
    read -r -p "  La tua selezione: " user_input

    if [ -z "${user_input}" ]; then
        echo ""
        info "Nessuna selezione effettuata. Uscita."
        exit 0
    fi

    # Normalizza l'input: sostituisce virgole con spazi, rimuove duplicati
    local normalized_input
    normalized_input=$(echo "${user_input}" | tr ',' ' ' | tr -s ' ')

    # Raccoglie le selezioni valide
    local to_add=()
    local to_add_descs=()
    local to_remove=()
    local invalid=0

    local num
    for num in ${normalized_input}; do
        # Verifica che sia un numero
        if [[ ! "${num}" =~ ^[0-9]+$ ]]; then
            warn "Valore non valido ignorato: '${num}'"
            continue
        fi

        local idx=$(( num - 1 ))

        # Verifica che l'indice sia nel range
        if [ "${idx}" -lt 0 ] || [ "${idx}" -ge "${USB_COUNT}" ]; then
            warn "Numero fuori range ignorato: ${num} (range: 1-${USB_COUNT})"
            invalid=1
            continue
        fi

        local id="${USB_IDS[$idx]}"
        local desc="${USB_DESCS[$idx]}"

        # FIX 4: usa la blacklist già letta in memoria
        if is_in_blacklist "${id}" "${current_blacklist}"; then
            to_remove+=("${id}")
        else
            to_add+=("${id}")
            to_add_descs+=("${desc}")
        fi
    done

    # Mostra il riepilogo delle modifiche e chiede conferma
    if [ "${#to_add[@]}" -eq 0 ] && [ "${#to_remove[@]}" -eq 0 ]; then
        echo ""
        warn "Nessuna modifica da applicare."
        exit 0
    fi

    section "Riepilogo modifiche"

    if [ "${#to_add[@]}" -gt 0 ]; then
        echo -e "  \e[1;32mDa AGGIUNGERE alla blacklist:\e[0m"
        local i
        for (( i=0; i<${#to_add[@]}; i++ )); do
            printf "    + \e[36m%-15s\e[0m  %s\n" "${to_add[$i]}" "${to_add_descs[$i]}"
        done
    fi

    if [ "${#to_remove[@]}" -gt 0 ]; then
        echo -e "  \e[1;31mDa RIMUOVERE dalla blacklist:\e[0m"
        local id
        for id in "${to_remove[@]}"; do
            printf "    - \e[36m%-15s\e[0m\n" "${id}"
        done
    fi

    echo ""
    read -r -p "  Confermi le modifiche? [s/N] " confirm

    if [[ ! "${confirm,,}" =~ ^(s|si|y|yes)$ ]]; then
        echo ""
        info "Operazione annullata."
        exit 0
    fi

    # Applica le modifiche
    section "Applicazione modifiche"

    local i
    for (( i=0; i<${#to_add[@]}; i++ )); do
        blacklist_add "${to_add[$i]}" "${to_add_descs[$i]}"
    done

    local id
    for id in "${to_remove[@]}"; do
        blacklist_remove "${id}"
    done

    # Mostra la blacklist aggiornata
    section "Blacklist aggiornata"
    local final_blacklist
    final_blacklist=$(read_blacklist)

    if [ -z "${final_blacklist}" ]; then
        echo "  (vuota)"
    else
        while IFS= read -r id; do
            printf "  \e[1;31m●\e[0m  \e[36m%s\e[0m\n" "${id}"
        done <<< "${final_blacklist}"
    fi

    # Enforcement immediato
    trigger_enforcement

    echo ""
    info "Operazione completata."
}

# ─────────────────────────────────────────────────────────────────────────────
# MODALITÀ NON INTERATTIVA
# ─────────────────────────────────────────────────────────────────────────────

cmd_list() {
    local entries
    entries=$(read_blacklist)

    if [ -z "${entries}" ]; then
        echo "(blacklist vuota)"
    else
        echo "${entries}"
    fi
}

cmd_add() {
    local raw_id="${1}"
    local id
    id=$(validate_usb_id "${raw_id}") || exit 1

    ensure_blacklist_file

    # Cerca una descrizione dal lsusb se disponibile
    local desc=""
    if command -v lsusb &>/dev/null; then
        desc=$(lsusb 2>/dev/null \
            | grep -i "${id}" \
            | sed -E 's/.*ID [0-9a-fA-F]{4}:[0-9a-fA-F]{4}\s*//' \
            | head -1 \
            | xargs \
            || true)
    fi

    blacklist_add "${id}" "${desc}"
    trigger_enforcement
}

cmd_remove() {
    local raw_id="${1}"
    local id
    id=$(validate_usb_id "${raw_id}") || exit 1

    ensure_blacklist_file
    blacklist_remove "${id}"
    trigger_enforcement
}

show_usage() {
    cat <<EOF
Uso: usb-blacklist-select [OPZIONE]

Senza opzioni: modalità interattiva (richiede terminale).

Opzioni:
  --list               Mostra gli ID attualmente in blacklist (uno per riga)
  --add VENDOR:PRODUCT Aggiunge un device alla blacklist e applica enforcement
  --remove VENDOR:PRODUCT Rimuove un device dalla blacklist e applica enforcement
  --help, -h           Mostra questo messaggio

Esempi:
  usb-blacklist-select
  usb-blacklist-select --add 2e8a:0005
  usb-blacklist-select --remove 0bda:8156
  usb-blacklist-select --list

File blacklist: ${BLACKLIST_FILE}
EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────

main() {
    check_root "$@"

    case "${1:-}" in
        --list)
            cmd_list
            ;;
        --add)
            if [ -z "${2:-}" ]; then
                error "--add richiede un argomento VENDOR:PRODUCT"
                exit 1
            fi
            cmd_add "${2}"
            ;;
        --remove)
            if [ -z "${2:-}" ]; then
                error "--remove richiede un argomento VENDOR:PRODUCT"
                exit 1
            fi
            cmd_remove "${2}"
            ;;
        --help|-h)
            show_usage
            ;;
        "")
            interactive_mode
            ;;
        *)
            error "Opzione sconosciuta: '${1}'"
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
