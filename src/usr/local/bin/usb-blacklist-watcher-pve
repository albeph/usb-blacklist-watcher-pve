#!/bin/bash
# usb-blacklist-watcher-pve — Systemd watcher for USB blacklist on Proxmox VE
#
# Monitors QEMU VM configuration directory and the blacklist file via inotify.
# Removes any blacklisted USB device found in VM configs using
# `qm set <VMID> --delete usbN`, whether the VM is running (hot-unplug)
# or stopped (static edit).
#
# The blacklist is reread from file on each enforcement: changes made via
# usb-blacklist-select or edited manually take effect immediately without
# restarting the service.

set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

readonly BLACKLIST_FILE="/etc/usb-blacklist-watcher-pve/blacklist.conf"
readonly QEMU_DIR="/etc/pve/qemu-server"
readonly DEBOUNCE_SECONDS="0.3"

# ─────────────────────────────────────────────────────────────────────────────
# UTILITIES
# ─────────────────────────────────────────────────────────────────────────────

log() {
    local level="${1}"; shift
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${level}] $*"
}

log_info()  { log "INFO " "$*"; }
log_warn()  { log "WARN " "$*"; }
log_error() { log "ERROR" "$*"; }

# ─────────────────────────────────────────────────────────────────────────────
# READ BLACKLIST
# ─────────────────────────────────────────────────────────────────────────────

# Reads the blacklist from the file and writes one VENDOR:PRODUCT per line to stdout.
# Blank lines and comments (#) are ignored. If the file does not exist, produces
# no output (empty blacklist → no enforcement).
read_blacklist() {
    if [ ! -f "${BLACKLIST_FILE}" ]; then
        return 0
    fi
    grep -v '^\s*#' "${BLACKLIST_FILE}" \
        | grep -v '^\s*$' \
        | awk '{print tolower($1)}' \
        | grep -E '^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$' \
        || true
}

# ─────────────────────────────────────────────────────────────────────────────
# CHECK BLACKLIST ON VM CONFIGS
# ─────────────────────────────────────────────────────────────────────────────

# Returns usbN keys (e.g. "usb0", "usb1") present in the VM config that
# contain a blacklisted device, one per line.
#
# FIX 1+5: Accepts optional pre-read blacklist as second argument,
# avoiding re-reading the file for every VM during enforce_all_confs.
# If omitted, reads it independently (single calls from enforce_conf).
#
# Arguments:
#   $1 — absolute path to .conf file
#   $2 — (optional) pre-read blacklist content
get_blacklisted_usb_keys() {
    local conf_file="${1}"
    local blacklist="${2:-$(read_blacklist)}"

    if [ -z "${blacklist}" ]; then
        return 0
    fi

    # Analyzes each usbN: line in the conf and resolves its effective ID.
    # Handles both VENDOR:PRODUCT and bus-port format (e.g. 1-4.2),
    # dynamically resolving the latter via sysfs in real-time.
    local line
    while IFS= read -r line; do
        local key
        key=$(echo "${line}" | grep -oP "^usb\d+" || true)
        [ -z "${key}" ] && continue

        local host_val
        host_val=$(echo "${line}" | grep -oP "host=\K[^, ]+" || true)
        [ -z "${host_val}" ] && continue

        local actual_id=""
        if [[ "${host_val}" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]]; then
            # VENDOR:PRODUCT format — use directly
            actual_id="${host_val,,}"
        elif [[ "${host_val}" =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]]; then
            # bus-port format (e.g. 1-4.2) — resolve via sysfs
            local sysfs_dir="/sys/bus/usb/devices/${host_val}"
            if [ -f "${sysfs_dir}/idVendor" ] && [ -f "${sysfs_dir}/idProduct" ]; then
                local vendor product
                vendor=$(cat "${sysfs_dir}/idVendor")
                product=$(cat "${sysfs_dir}/idProduct")
                actual_id="${vendor,,}:${product,,}"
            else
                log_warn "bus-port '${host_val}' non trovata in sysfs — device scollegato?"
            fi
        fi

        [ -z "${actual_id}" ] && continue

        # If effective ID (vendor:product) is blacklisted, emit key
        if echo "${blacklist}" | grep -qi "^${actual_id}$"; then
            echo "${key}"
        fi
    done < <(grep -iP "^usb\d+:" "${conf_file}" || true)
}

# ─────────────────────────────────────────────────────────────────────────────
# ACTION — REMOVE USB ENTRY
# ─────────────────────────────────────────────────────────────────────────────

# Applies enforcement on a single VM config.
#
# FIX 1: get_blacklisted_usb_keys called ONLY ONCE (eliminated
#        redundant previous call via conf_has_blacklisted_device).
# FIX 3: exit code of qm captured properly without pipes.
# FIX 5: accepts optional pre-read blacklist as second argument.
#
# Arguments:
#   $1 — VMID (integer, e.g. 100)
#   $2 — (optional) pre-read blacklist content
enforce_conf() {
    local vmid="${1}"
    local blacklist="${2:-$(read_blacklist)}"
    local conf_file="${QEMU_DIR}/${vmid}.conf"

    if [ ! -f "${conf_file}" ]; then
        log_warn "enforce_conf: file non trovato per VMID ${vmid}: ${conf_file}"
        return 0
    fi

    # FIX 1: single call — result is used for both check and action
    local keys
    keys=$(get_blacklisted_usb_keys "${conf_file}" "${blacklist}" | sort -u)

    [ -z "${keys}" ] && return 0  # no blacklisted device found → nothing to do

    local key
    while IFS= read -r key; do
        [ -z "${key}" ] && continue

        local current_value
        current_value=$(grep -iP "^${key}:" "${conf_file}" | head -1 | cut -d' ' -f2- || echo "?")

        log_info "VM ${vmid}: rimozione device USB in blacklist — chiave='${key}' valore='${current_value}'"

        if command -v qm &>/dev/null; then
            # FIX 3: capture output and exit code without pipe (which swallows exit code)
            local qm_output qm_rc
            qm_output=$(qm set "${vmid}" --delete "${key}" 2>&1) && qm_rc=0 || qm_rc=$?
            [ -n "${qm_output}" ] && log_info "  qm output: ${qm_output}"
            if [ "${qm_rc}" -eq 0 ]; then
                log_info "VM ${vmid}: '${key}' rimosso con successo."
            else
                log_error "VM ${vmid}: errore (rc=${qm_rc}) rimuovendo '${key}'. Verifica: qm set ${vmid} --delete ${key}"
            fi
        else
            log_error "Comando 'qm' non trovato nel PATH — impossibile rimuovere '${key}' dalla VM ${vmid}."
            log_error "Assicurarsi che il pacchetto Proxmox VE sia installato e che qm sia raggiungibile."
        fi
    done <<< "${keys}"
}

# ─────────────────────────────────────────────────────────────────────────────
# ENFORCEMENT ON ALL CONFIGS
# ─────────────────────────────────────────────────────────────────────────────

# Scans all *.conf files in QEMU_DIR and applies enforce_conf.
#
# FIX 5: reads blacklist ONLY ONCE and passes it to each enforce_conf,
#        avoiding N file reads (one per VM) as previously done.
enforce_all_confs() {
    if [ ! -d "${QEMU_DIR}" ]; then
        log_warn "Directory QEMU non trovata: ${QEMU_DIR} — pve-cluster montato?"
        return 0
    fi

    # Single blacklist read for entire cycle
    local blacklist
    blacklist=$(read_blacklist)

    if [ -z "${blacklist}" ]; then
        log_info "Blacklist vuota — nessun enforcement necessario."
        return 0
    fi

    local conf_file vmid
    local count=0

    for conf_file in "${QEMU_DIR}/"*.conf; do
        [ -f "${conf_file}" ] || continue
        vmid=$(basename "${conf_file}" .conf)
        if [[ ! "${vmid}" =~ ^[0-9]+$ ]]; then
            log_warn "Skipping file con nome non numerico: ${conf_file}"
            continue
        fi
        # FIX 5: passes pre-read blacklist (does not re-read for each VM)
        enforce_conf "${vmid}" "${blacklist}"
        (( count++ )) || true
    done

    log_info "Enforcement completato su ${count} VM."
}

# ─────────────────────────────────────────────────────────────────────────────
# DEBOUNCE — Scheduling with cancellation of previous pending job
# ─────────────────────────────────────────────────────────────────────────────

# FIX 2: true debounce — previous job is killed before scheduling
# a new one. Rapid multiple events generate a single enforcement pass, launched
# DEBOUNCE_SECONDS after the last received event.

# PID of last global pending enforcement job
PENDING_ALL_PID=""

# Map vmid → PID of pending job for that specific VM
declare -A PENDING_VM_PIDS=()

# Schedules enforce_all_confs with debounce.
# If a job is already pending, cancels it before scheduling a new one.
schedule_enforce_all() {
    if [ -n "${PENDING_ALL_PID}" ]; then
        kill "${PENDING_ALL_PID}" 2>/dev/null || true
    fi
    ( sleep "${DEBOUNCE_SECONDS}" && enforce_all_confs ) &
    PENDING_ALL_PID=$!
}

# Schedules enforce_conf for a single VM with debounce.
# If a job for this VM is already pending, cancels it first.
schedule_enforce_vm() {
    local vmid="${1}"
    local prev_pid="${PENDING_VM_PIDS[${vmid}]:-}"
    if [ -n "${prev_pid}" ]; then
        kill "${prev_pid}" 2>/dev/null || true
    fi
    ( sleep "${DEBOUNCE_SECONDS}" && enforce_conf "${vmid}" ) &
    PENDING_VM_PIDS["${vmid}"]=$!
}

# ─────────────────────────────────────────────────────────────────────────────
# WATCHER — INOTIFY LOOP
# ─────────────────────────────────────────────────────────────────────────────

watch_loop() {
    if ! command -v inotifywait &>/dev/null; then
        log_error "Comando 'inotifywait' non trovato. Installare inotify-tools."
        exit 1
    fi

    if [ ! -d "${QEMU_DIR}" ]; then
        log_warn "Directory QEMU non trovata: ${QEMU_DIR}. Attendo che diventi disponibile..."
        while [ ! -d "${QEMU_DIR}" ]; do
            sleep 5
        done
        log_info "Directory QEMU rilevata: ${QEMU_DIR}. Avvio il monitoring."
    fi

    local blacklist_dir
    blacklist_dir=$(dirname "${BLACKLIST_FILE}")

    log_info "Avvio monitoring inotify su: ${QEMU_DIR}/ e ${blacklist_dir}"

    # NOTE: Process substitution < <(...) is used instead of pipe | while.
    # With pipe, while runs in a subshell and PENDING_*_PID variables
    # would not persist between iterations, making debouncing ineffective.
    while IFS=' ' read -r filepath event; do

        # ── Blacklist file modified ──────────────────────────────────────────
        if [ "${filepath}" = "${BLACKLIST_FILE}" ]; then
            log_info "Blacklist modificata (${event}): scheduling enforcement su tutte le VM..."
            schedule_enforce_all
            continue
        fi

        # ── VM config modified ───────────────────────────────────────────────
        if [[ "${filepath}" == "${QEMU_DIR}/"*.conf ]]; then
            local vmid
            vmid=$(basename "${filepath}" .conf)
            [[ "${vmid}" =~ ^[0-9]+$ ]] || continue
            log_info "Modifica rilevata per VM ${vmid} (${event}): scheduling enforcement..."
            schedule_enforce_vm "${vmid}"
        fi

    done < <(inotifywait \
        --monitor \
        --quiet \
        --event modify,close_write,create,moved_to \
        --format '%w%f %e' \
        "${QEMU_DIR}/" \
        "${blacklist_dir}")
}

# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────

main() {
    log_info "========================================================"
    log_info "usb-blacklist-watcher-pve avviato"
    log_info "  QEMU dir:      ${QEMU_DIR}"
    log_info "  Blacklist:     ${BLACKLIST_FILE}"
    log_info "  Debounce:      ${DEBOUNCE_SECONDS}s"
    log_info "========================================================"

    # Verify essential dependencies
    if ! command -v qm &>/dev/null; then
        log_warn "Comando 'qm' non trovato nel PATH."
        log_warn "Il watcher girerà ma non potrà rimuovere USB dalle VM."
        log_warn "Assicurarsi che Proxmox VE sia installato correttamente."
    fi

    # Initial enforcement on service startup
    log_info "Enforcement iniziale su tutti i conf VM esistenti..."
    enforce_all_confs

    # Then enter continuous monitoring loop
    log_info "Avvio del monitoring inotify..."
    watch_loop
}

main "$@"
